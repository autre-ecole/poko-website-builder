<div class="people grid-fluid width-body">
  {% for ageGroup, items in collections.people | groupby("data.vars.ageGroup") %}
    {% for item in items %}
      <div>
        <figure class="front-and-back pile">
          {% if item.data.dataList[0].src %}
            {% image src=item.data.dataList[0].src, width="350", class="person back", aspectRatio="1", style=item.data.vars.previewImgStyle | default("") %}
          {% endif %}
          {% image src=item.data.preview.image.src, alt=item.data.name, width="350", class="person front", aspectRatio="1", style=item.data.vars.previewImgStyle | default("") %}
        </figure>
        <p>
          <strong>{{ item.data.name }}</strong>
        </p>
        {% if item.data.vars.role %}
          <p class="h5">{{ item.data.vars.role }}</p>
        {% endif %}
        {% if item.data.vars.classroom %}
          <p class="h5">{{ item.data.vars.classroom }}</p>
        {% endif %}
        {% if item.data.vars.classCycle %}
          <p class="h5">{{ item.data.vars.classCycle }}</p>
        {% endif %}
        {% if item.data.vars.personalEmail %}
          <p class="h5">{{ item.data.vars.personalEmail | emailLink }}</p>
        {% endif %}
      </div>
    {% endfor %}
  {% endfor %}
</div>
<style>
  .people.grid-fluid {
    --columns: 7;
  }
  .people.grid-fluid img {
    max-inline-size: 100%;
  }
  .people.grid-fluid .front-and-back {
    margin: 0;
    box-shadow: var(--box-shadow-grid);
    border-radius: var(--border-radius-grid);
    overflow: hidden;
  }
  .person.front {
    background: var(--color-bg);
  }
  .person {
    aspect-ratio: 1;
  }
  .people .h5 {
    margin-block-start: 0;
  }
  .front-and-back > .front {
    opacity: 1;
    transition: opacity 0.1s ease-in-out;
  }
  .front-and-back:hover > .back + .front {
    opacity: 0;
  }
</style>